# ==============================================================================
# DocuMind-RAG Environment Configuration Template
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Options: 'bedrock' or 'ollama'
EMBEDDING_PROVIDER=bedrock

# AWS Bedrock Configuration (if using Bedrock embeddings)
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Ollama Configuration (if using local Ollama embeddings/LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=mistral

# ------------------------------------------------------------------------------
# Vector Store & Storage Paths
# ------------------------------------------------------------------------------
CHROMA_PATH=chroma
DATA_PATH=data

# ------------------------------------------------------------------------------
# RAG Chunking Parameters
# ------------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K_RESULTS=5
